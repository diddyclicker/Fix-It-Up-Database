# GitHub repository that stores data/cars.json
GITHUB_OWNER=your-github-username
GITHUB_REPO=Fix-It-Up-Database
GITHUB_BRANCH=main

# Fine-grained GitHub token: Contents read/write for THIS repository only.
# Keep this only in Vercel Environment Variables or local .env.local.
GITHUB_TOKEN=replace-with-your-token

# Choose a long, unique admin password. Keep it private.
ADMIN_PASSWORD=replace-with-a-long-random-password
